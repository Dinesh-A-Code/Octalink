# Canonical origin used for metadata, sitemap.xml and robots.txt.
# Required before a production build; unset is fine for local development.
NEXT_PUBLIC_SITE_URL=

# Where the contact form POSTs (a Formspree URL, or a Worker/route handler
# relaying to Resend). Leave unset to render the form in its disabled state.
NEXT_PUBLIC_CONTACT_ENDPOINT=
